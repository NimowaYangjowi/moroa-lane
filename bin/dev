#!/usr/bin/env ruby
env_path = File.expand_path("../.env", __dir__)

if File.exist?(env_path)
  File.readlines(env_path, chomp: true).each do |line|
    next if line.empty? || line.start_with?("#")

    key, value = line.split("=", 2)
    next if key.nil? || value.nil? || ENV.key?(key)

    ENV[key] = value.gsub(/\A['"]|['"]\z/, "")
  end
end

args = ARGV.dup
has_port = args.any? { |arg| arg == "-p" || arg == "--port" || arg.start_with?("--port=") }

args = [ "-p", ENV.fetch("PORT", "3001"), *args ] unless has_port

exec "./bin/rails", "server", *args
