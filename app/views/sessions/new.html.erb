<section class="auth-shell">
  <div class="auth-panel">
    <p class="eyebrow">Member identity</p>
    <h1>Log in to become a known customer.</h1>
    <p>
      After login, the demo can explain how a stable member ID connects the shopping account
      to ChannelTalk support history.
    </p>

    <div class="demo-credentials">
      <p>Demo account</p>
      <code>jiwoo@example.com</code>
      <code>password123</code>
    </div>

    <%= form_with url: session_path, class: "form-stack", data: { turbo: false }, html: { autocomplete: "off" } do |form| %>
      <label>
        Email
        <%= text_field_tag :login_email, nil, required: true, autofocus: true, inputmode: "email", autocomplete: "off", autocapitalize: "none", spellcheck: false, placeholder: "jiwoo@example.com" %>
      </label>

      <label>
        Password
        <%= password_field_tag :login_password, nil, required: true, autocomplete: "off", placeholder: "password123", maxlength: 72 %>
      </label>

      <%= form.submit "Log in", class: "button" %>
    <% end %>

    <div class="auth-links">
      <%= link_to "Create an account", new_registration_path %>
      <%= link_to "Forgot password?", new_password_path %>
    </div>
  </div>
</section>
