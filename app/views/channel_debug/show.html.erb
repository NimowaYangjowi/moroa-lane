<section class="page-hero compact-hero">
  <p class="eyebrow">Customer care</p>
  <h1>How can we help?</h1>
  <p>
    Ask about your routine, compare products, or get help with a recent order.
  </p>
</section>

<section class="section dashboard-grid">
  <div class="profile-panel">
    <p class="eyebrow">Product guidance</p>
    <h2>Find the right fit.</h2>
    <p class="muted-copy">
      Tell us your skin type, current routine, and what you want to improve. We will help narrow
      the options.
    </p>
  </div>

  <div class="profile-panel">
    <p class="eyebrow">Account help</p>
    <% if current_user %>
      <h2>We have your details.</h2>
      <p class="muted-copy">
        You are signed in, so we can help with your cart, recent product views, and past orders.
      </p>
    <% else %>
      <h2>Shopping as a guest.</h2>
      <p class="muted-copy">
        Sign in if you want us to look up your saved cart or order history.
      </p>
    <% end %>
  </div>

  <div class="profile-panel">
    <p class="eyebrow">Shopping help</p>
    <h2>Continue where you left off.</h2>
    <p class="muted-copy">
      We can help compare items in your cart, check product details, or suggest what to add next.
    </p>
    <%= link_to "Browse products", products_path, class: "button secondary-button panel-action" %>
  </div>
</section>
