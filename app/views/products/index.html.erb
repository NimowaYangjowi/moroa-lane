<section class="page-hero compact-hero">
  <p class="eyebrow">Shop skincare</p>
  <h1>Daily care for a balanced routine.</h1>
  <p>
    Find cleansers, serums, moisturizers, and sunscreen matched to the way your skin feels today.
  </p>
</section>

<section class="section">
  <div class="collection-toolbar">
    <div>
      <p class="eyebrow">Collection</p>
      <h2><%= pluralize(@products.size, "product") %></h2>
    </div>
    <p class="toolbar-note">Curated skincare essentials.</p>
  </div>

  <div class="product-grid">
    <% @products.each do |product| %>
      <%= link_to product_path(product), class: "product-card" do %>
        <%= image_tag product.image_url, alt: product.name, class: "product-card-image" %>
        <div class="product-card-body">
          <p class="product-meta"><%= product.category %> · <%= product.skin_type %></p>
          <h3><%= product.name %></h3>
          <p><%= truncate(product.description, length: 110) %></p>
          <strong><%= money(product.price_cents) %></strong>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
