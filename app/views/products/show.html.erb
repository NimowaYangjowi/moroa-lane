<section class="product-detail">
  <div class="product-media">
    <%= image_tag @product.image_url, alt: @product.name %>
  </div>

  <div class="product-info">
    <p class="eyebrow"><%= @product.category %> · <%= @product.skin_type %></p>
    <h1><%= @product.name %></h1>
    <p class="price"><%= money(@product.price_cents) %></p>
    <p class="product-description"><%= @product.description %></p>

    <div class="product-actions">
      <% if current_user %>
        <%= form_with url: cart_items_path, class: "inline-form", data: { turbo: false } do |form| %>
          <%= hidden_field_tag :product_id, @product.id %>
          <%= number_field_tag :quantity, @cart_item&.quantity || 1, min: 1, max: 9, class: "quantity-input", aria: { label: "Quantity" } %>
          <%= form.submit @cart_item ? "Update cart" : "Add to cart", class: "button" %>
        <% end %>
        <span><%= @cart_item ? "This item is already in your cart." : "Choose a quantity before adding this item." %></span>
      <% else %>
        <%= link_to "Log in to add to cart", new_session_path, class: "button" %>
        <span>Sign in to save this product to your cart.</span>
      <% end %>
    </div>

    <div class="support-context">
      <h2>Need help choosing?</h2>
      <p>
        Our team can help compare ingredients, texture, and routine order before you add this
        product to your shelf.
      </p>
    </div>
  </div>
</section>

<% if @recent_products.any? %>
  <section class="section">
    <p class="eyebrow">Recently viewed</p>
    <h2>Other products from this session</h2>
    <div class="product-grid small-grid">
      <% @recent_products.each do |product| %>
        <%= link_to product_path(product), class: "product-card" do %>
          <%= image_tag product.image_url, alt: product.name, class: "product-card-image" %>
          <div class="product-card-body">
            <p class="product-meta"><%= product.category %></p>
            <h3><%= product.name %></h3>
            <strong><%= money(product.price_cents) %></strong>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
