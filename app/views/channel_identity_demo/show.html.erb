<section class="identity-demo-shell" data-controller="identity-demo">
  <header class="identity-demo-header">
    <div>
      <p class="eyebrow">ChannelTalk Identity Flow</p>
      <h1>memberId to userId to S2S Purchase</h1>
    </div>
    <div class="identity-demo-actions">
      <button class="button" type="button" data-demo-action="purchase">① Create purchase</button>
      <button class="button" type="button" data-demo-action="deliver">② Send to ChannelTalk</button>
      <button class="button refresh-button" type="button" data-demo-action="refresh">Refresh</button>
    </div>
  </header>

  <div
    id="identity-demo-board"
    class="identity-demo-board"
    data-status-url="<%= channel_identity_demo_status_path %>"
    data-purchase-url="<%= channel_identity_demo_purchase_path %>"
    data-delivery-url="<%= channel_identity_demo_delivery_path %>"
  >
    <div class="board-status">
      <span class="board-status-label">S2S delivery</span>
      <span class="state-chip" data-field="deliveryState">none</span>
      <span class="board-status-note" data-field="credentialNote"></span>
    </div>

    <section class="identity-bridge" aria-label="Identity transformation">
      <article class="bridge-side bridge-input">
        <span class="bridge-role">input · Acme가 만든 키</span>
        <p class="eyebrow">memberId</p>
        <strong data-field="memberId">-</strong>
      </article>
      <div class="bridge-arrow">
        <span class="bridge-op">User API lookup</span>
        <code class="bridge-op-path">GET /open/v5/users/@{memberId}</code>
        <span class="bridge-arrow-line" aria-hidden="true"></span>
      </div>
      <article class="bridge-side bridge-output">
        <span class="bridge-role">output · 채널톡이 발급</span>
        <p class="eyebrow">userId</p>
        <strong data-field="channelUserId">not synced</strong>
        <span class="state-chip" data-field="mappingStatus">not_created</span>
      </article>
    </section>

    <section class="identity-counters" aria-label="Live record counters">
      <article>
        <span>Purchase events</span>
        <strong data-metric="purchaseEvents">0</strong>
      </article>
      <article>
        <span>Orders</span>
        <strong data-metric="orders">0</strong>
      </article>
      <article>
        <span>Deliveries</span>
        <strong data-metric="deliveries">0</strong>
      </article>
    </section>

    <section class="identity-flow-board">
      <div class="identity-section-heading">
        <p class="eyebrow">Flowchart</p>
        <small data-field="generatedAt">-</small>
      </div>
      <div class="identity-stage-list" data-flow-list></div>
    </section>

    <section class="identity-inspector">
      <div class="payload-panel">
        <div class="identity-section-heading">
          <p class="eyebrow">S2S Purchase body</p>
          <span class="payload-badge">server-generated · not browser SDK</span>
        </div>
        <pre><code data-json="payload">null</code></pre>
      </div>
    </section>

    <section class="record-board" aria-label="Database records">
      <div class="identity-section-heading">
        <p class="eyebrow">Database records</p>
        <span>actual latest rows</span>
      </div>
      <div class="record-grid" data-record-grid></div>
    </section>
  </div>
</section>

<script>
  (function() {
    var board = document.getElementById("identity-demo-board");
    if (!board) { return; }

    var csrfToken = document.querySelector("meta[name='csrf-token']") && document.querySelector("meta[name='csrf-token']").content;
    var actionButtons = Array.prototype.slice.call(document.querySelectorAll("[data-demo-action]"));

    function setText(selector, value) {
      var element = board.querySelector(selector);
      if (!element) { return; }
      element.textContent = value === null || value === undefined || value === "" ? "-" : String(value);
    }

    function setStateChip(element, value) {
      if (!element) { return; }
      element.textContent = value || "none";
      element.dataset.state = value || "none";
    }

    function setStateChipAll(selector, value) {
      Array.prototype.forEach.call(board.querySelectorAll(selector), function(element) {
        setStateChip(element, value);
      });
    }

    function requestLine(request) {
      if (!request) { return "-"; }
      return request.method + " " + request.path;
    }

    function formatTime(iso) {
      if (!iso) { return "-"; }
      var date = new Date(iso);
      return isNaN(date.getTime()) ? iso : date.toLocaleTimeString();
    }

    // Change highlight: pulse a value only when it actually changed between polls,
    // so a click or background update is visible. Skips the first render.
    var lastValues = {};
    var hasRendered = false;

    function pulse(element) {
      if (!element) { return; }
      element.classList.remove("pulse");
      void element.offsetWidth;
      element.classList.add("pulse");
    }

    function trackPulse(key, value, selector) {
      var changed = hasRendered && lastValues.hasOwnProperty(key) && lastValues[key] !== value;
      lastValues[key] = value;
      if (!changed) { return; }
      Array.prototype.forEach.call(board.querySelectorAll(selector), function(element) {
        pulse(element.closest("article") || element);
      });
    }

    var RECORD_ORDER = [ "channel_user_mappings", "events", "channel_event_deliveries", "users", "orders" ];
    var CORE_RECORDS = { channel_user_mappings: true, events: true, channel_event_deliveries: true };
    var RECORD_CELL_ROLE = { member_id: "input", channel_user_id: "output" };
    var CELL_ROLE_TABLES = { channel_user_mappings: true, channel_event_deliveries: true };

    function renderFlow(data) {
      var flow = data.flow || [];
      var requests = data.requests || {};
      var identity = data.identity || {};
      var deliveryRecord = data.records && data.records.channel_event_deliveries;
      var list = board.querySelector("[data-flow-list]");
      list.innerHTML = "";
      flow.forEach(function(step, index) {
        if (index > 0) {
          var arrow = document.createElement("div");
          arrow.className = "rail-arrow";
          arrow.setAttribute("aria-hidden", "true");
          list.appendChild(arrow);
        }
        var item = document.createElement("article");
        item.className = "identity-stage rail-stage";
        item.dataset.keyRole = step.keyRole || "";
        item.dataset.stageKey = step.key || "";
        item.innerHTML = "<span class='stage-index'></span><strong class='stage-label'></strong><small class='stage-value'></small>";
        item.querySelector(".stage-index").textContent = String(index + 1).padStart(2, "0");
        item.querySelector(".stage-label").textContent = step.label;

        var valueEl = item.querySelector(".stage-value");
        if (step.key === "user_api" && requests.userLookup) {
          valueEl.textContent = requestLine(requests.userLookup);
          valueEl.classList.add("stage-path");
        } else if (step.key === "s2s_event" && requests.eventCreate) {
          valueEl.textContent = requestLine(requests.eventCreate);
          valueEl.classList.add("stage-path");
        } else if (step.key === "delivery") {
          valueEl.remove();
          var chip = document.createElement("span");
          chip.className = "state-chip";
          setStateChip(chip, identity.deliveryState);
          item.appendChild(chip);
          if (identity.deliveryState === "failed" && deliveryRecord && deliveryRecord.last_error) {
            var cause = document.createElement("small");
            cause.className = "stage-error";
            cause.textContent = deliveryRecord.last_error;
            item.appendChild(cause);
          }
        } else {
          valueEl.textContent = step.value || "-";
        }
        list.appendChild(item);
      });
    }

    function recordTableNames(records) {
      var present = Object.keys(records || {});
      var ordered = RECORD_ORDER.filter(function(name) { return present.indexOf(name) !== -1; });
      var extras = present.filter(function(name) { return RECORD_ORDER.indexOf(name) === -1; });
      return ordered.concat(extras);
    }

    function renderRecords(records) {
      var grid = board.querySelector("[data-record-grid]");
      grid.innerHTML = "";
      recordTableNames(records).forEach(function(tableName) {
        var record = records[tableName];
        var article = document.createElement("article");
        article.className = "record-table " + (CORE_RECORDS[tableName] ? "record-core" : "record-secondary");

        var title = document.createElement("h2");
        title.textContent = tableName;
        article.appendChild(title);

        if (!record) {
          var empty = document.createElement("p");
          empty.className = "muted-copy";
          empty.textContent = "no row";
          article.appendChild(empty);
        } else {
          var table = document.createElement("table");
          var body = document.createElement("tbody");
          Object.keys(record).forEach(function(key) {
            var row = document.createElement("tr");
            var heading = document.createElement("th");
            var value = document.createElement("td");
            heading.scope = "row";
            heading.textContent = key;
            value.textContent = typeof record[key] === "object" && record[key] !== null ? JSON.stringify(record[key]) : String(record[key] ?? "-");
            if (CELL_ROLE_TABLES[tableName] && RECORD_CELL_ROLE[key]) {
              value.classList.add("cell-" + RECORD_CELL_ROLE[key]);
            }
            row.appendChild(heading);
            row.appendChild(value);
            body.appendChild(row);
          });
          table.appendChild(body);
          article.appendChild(table);
        }

        grid.appendChild(article);

        var signature = JSON.stringify(record || null);
        var key = "record:" + tableName;
        if (hasRendered && lastValues.hasOwnProperty(key) && lastValues[key] !== signature) {
          pulse(article);
        }
        lastValues[key] = signature;
      });
    }

    function render(data) {
      var identity = data.identity || {};
      var metrics = data.metrics || {};
      setText("[data-field='memberId']", identity.memberId);
      setText("[data-field='channelUserId']", identity.channelUserId || "not synced");
      setStateChipAll("[data-field='mappingStatus']", identity.mappingStatus);
      setStateChipAll("[data-field='deliveryState']", identity.deliveryState);
      setText("[data-field='credentialNote']", identity.credentialsConfigured ? "credentials configured" : "demo · credentials not set");
      setText("[data-field='generatedAt']", formatTime(data.generatedAt));

      setText("[data-metric='purchaseEvents']", metrics.purchaseEvents);
      setText("[data-metric='orders']", metrics.orders);
      setText("[data-metric='deliveries']", metrics.deliveries);

      board.querySelector("[data-json='payload']").textContent = data.payload ? JSON.stringify(data.payload, null, 2) : "null";
      renderFlow(data);
      renderRecords(data.records);

      trackPulse("purchaseEvents", metrics.purchaseEvents, "[data-metric='purchaseEvents']");
      trackPulse("orders", metrics.orders, "[data-metric='orders']");
      trackPulse("deliveries", metrics.deliveries, "[data-metric='deliveries']");
      trackPulse("mappingStatus", identity.mappingStatus, "[data-field='mappingStatus']");
      trackPulse("deliveryState", identity.deliveryState, "[data-field='deliveryState']");
      hasRendered = true;
    }

    function loadStatus() {
      return fetch(board.dataset.statusUrl, { headers: { accept: "application/json" } })
        .then(function(response) { return response.json(); })
        .then(render);
    }

    function postAction(url) {
      actionButtons.forEach(function(button) { button.disabled = true; });
      return fetch(url, {
        method: "POST",
        headers: {
          accept: "application/json",
          "x-csrf-token": csrfToken
        }
      })
        .then(function(response) { return response.json(); })
        .then(render)
        .finally(function() {
          actionButtons.forEach(function(button) { button.disabled = false; });
          window.setTimeout(loadStatus, 600);
        });
    }

    actionButtons.forEach(function(button) {
      button.addEventListener("click", function() {
        if (button.dataset.demoAction === "purchase") { postAction(board.dataset.purchaseUrl); }
        if (button.dataset.demoAction === "deliver") { postAction(board.dataset.deliveryUrl); }
        if (button.dataset.demoAction === "refresh") { loadStatus(); }
      });
    });

    loadStatus();
    window.setInterval(loadStatus, 2000);
  })();
</script>
