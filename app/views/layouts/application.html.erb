<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Luma & Leaf" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Luma & Leaf">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <%= link_to "Luma & Leaf", root_path, class: "brand-link" %>
      <nav class="site-nav" aria-label="Primary">
        <%= link_to "Shop", products_path %>
        <%= link_to "Demo Scope", root_path(anchor: "scope") %>
        <% if current_user %>
          <%= link_to "My page", account_path %>
          <%= button_to "Log out", session_path, method: :delete, class: "nav-button" %>
        <% else %>
          <%= link_to "Log in", new_session_path %>
          <%= link_to "Join", new_registration_path %>
        <% end %>
      </nav>
    </header>

    <main>
      <% if flash[:notice].present? || flash[:alert].present? %>
        <div class="flash-wrap">
          <%= tag.div(flash[:notice], class: "flash notice") if flash[:notice].present? %>
          <%= tag.div(flash[:alert], class: "flash alert") if flash[:alert].present? %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
