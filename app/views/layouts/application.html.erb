<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Moroa Lane" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Moroa Lane">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <%= link_to "Moroa Lane", root_path, class: "brand-link" %>
      <nav class="site-nav" aria-label="Primary">
        <%= link_to "Shop", products_path %>
        <%= link_to "Guide", channel_talk_guide_path %>
        <%= link_to "About", root_path(anchor: "scope") %>
        <% if current_user %>
          <%= link_to "My page", account_path %>
          <%= link_to "Cart (#{current_user.cart_items_count})", cart_path %>
          <%= button_to "Log out", session_path, method: :delete, class: "nav-button", form: { data: { turbo: false, channel_logout_form: true } } %>
        <% else %>
          <%= link_to "Log in", new_session_path %>
          <%= link_to "Join", new_registration_path %>
        <% end %>
      </nav>
    </header>

    <main>
      <% if flash[:notice].present? || flash[:alert].present? %>
        <div class="flash-wrap">
          <%= tag.div(flash[:notice], class: "flash notice") if flash[:notice].present? %>
          <%= tag.div(flash[:alert], class: "flash alert") if flash[:alert].present? %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <% channel_logged_out = flash[:channel_logged_out].present? %>
    <% channel_suppressed_after_logout = cookies[:channel_member_logged_out].present? && current_user.blank? %>
    <% if channel_sdk_enabled? && !channel_logged_out && !channel_suppressed_after_logout %>
      <script>
        (function(){var w=window;if(w.ChannelIO){return w.console.error("ChannelIO script included twice.");}var ch=function(){ch.c(arguments);};ch.q=[];ch.c=function(args){ch.q.push(args);};w.ChannelIO=ch;function l(){if(w.ChannelIOInitialized){return;}w.ChannelIOInitialized=true;var s=document.createElement("script");s.type="text/javascript";s.async=true;s.src="https://cdn.channel.io/plugin/ch-plugin-web.js";var x=document.getElementsByTagName("script")[0];if(x.parentNode){x.parentNode.insertBefore(s,x);}}if(document.readyState==="complete"){l();}else{w.addEventListener("DOMContentLoaded",l);w.addEventListener("load",l);}})();
        var channelBootOptions = <%= raw json_escape(channel_boot_options.to_json) %>;

        function clearChannelTalkBrowserState() {
          try {
            Object.keys(window.localStorage || {}).forEach(function(key) {
              if (key.indexOf("Channel.") === 0) { window.localStorage.removeItem(key); }
            });
            Object.keys(window.sessionStorage || {}).forEach(function(key) {
              if (key.indexOf("Channel.") === 0) { window.sessionStorage.removeItem(key); }
            });
            document.cookie = "_channeltalk_session=; Max-Age=0; path=/; SameSite=Lax";
          } catch (error) {
            console.warn("ChannelTalk browser state cleanup failed", error);
          }
        }

        function bootChannelTalk() {
          ChannelIO("boot", channelBootOptions, function(error) {
            if (error) { console.error("ChannelTalk boot failed", error); }
          });
        }

        bootChannelTalk();

        document.addEventListener("submit", function(event) {
          var form = event.target;
          if (!form.matches("[data-channel-logout-form]")) { return; }

          if (window.ChannelIO) {
            clearChannelTalkBrowserState();
            ChannelIO("shutdown");
          }
        }, true);
      </script>
    <% elsif channel_sdk_enabled? && (channel_logged_out || channel_suppressed_after_logout) %>
      <script>
        try {
          Object.keys(window.localStorage || {}).forEach(function(key) {
            if (key.indexOf("Channel.") === 0) { window.localStorage.removeItem(key); }
          });
          Object.keys(window.sessionStorage || {}).forEach(function(key) {
            if (key.indexOf("Channel.") === 0) { window.sessionStorage.removeItem(key); }
          });
          document.cookie = "_channeltalk_session=; Max-Age=0; path=/; SameSite=Lax";
        } catch (error) {
          console.warn("ChannelTalk browser state cleanup failed", error);
        }
      </script>
    <% else %>
      <%= link_to "Chat with us", channel_debug_path, class: "channel-fallback-button" %>
    <% end %>
  </body>
</html>
